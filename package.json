{
  "name": "relic-route-forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-zone quest placement tool: places quest objects into a given 3D scene, verifies route / ordering / interaction reachability, and emits walkable completion proofs.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import ./scripts/register-ts.mjs --test tests/*.test.mjs",
    "place": "node --import ./scripts/register-ts.mjs scripts/place.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "esbuild": "0.25.10",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "7.2.2"
  }
}
